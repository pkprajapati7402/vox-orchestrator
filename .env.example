# =============================================================================
# Vox-Orchestrator — environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
#   cp .env.example .env
# Every value below has a safe default in app/config.py unless marked REQUIRED,
# so the API, the eval harness and the test-suite all boot with an empty file.
# =============================================================================

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
APP_ENV=development                  # development | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                       # true -> JSON logs (use in production)
HOST=0.0.0.0
PORT=8000
# Public base URL Twilio can reach (ngrok in dev, Koyeb/Cloud Run URL in prod).
# No trailing slash. REQUIRED before placing real calls.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# -----------------------------------------------------------------------------
# Telephony — Twilio (Voice + Media Streams + AMD)
# https://console.twilio.com
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006     # E.164. Twilio trial: calls only to verified numbers
TWILIO_VALIDATE_SIGNATURES=true      # verify X-Twilio-Signature on inbound webhooks
TWILIO_AMD_ENABLED=true              # answering-machine detection
TWILIO_AMD_TIMEOUT_SECONDS=15
TWILIO_CALL_TIMEOUT_SECONDS=30       # ring timeout
TWILIO_MAX_CALL_SECONDS=420          # hard cap per call (7 min)

# -----------------------------------------------------------------------------
# LLM — primary: Groq (Llama 3.3 70B), fallback: Gemini Flash
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

LLM_PRIMARY_PROVIDER=groq            # groq | gemini | mock
LLM_FALLBACK_PROVIDER=gemini         # groq | gemini | mock | none
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1                    # retries against the *same* provider before failing over
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=400

# -----------------------------------------------------------------------------
# Speech-to-text — primary: Groq Whisper, fallback: Deepgram
# -----------------------------------------------------------------------------
GROQ_STT_MODEL=whisper-large-v3-turbo
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2-phonecall
STT_PRIMARY_PROVIDER=groq            # groq | deepgram
STT_LANGUAGE=en                      # 'en' handles Hindi-English code-switching reasonably
STT_MIN_CONFIDENCE=0.55              # below this -> "sorry, could you repeat that?" (once)

# -----------------------------------------------------------------------------
# Text-to-speech — primary: ElevenLabs, fallback: Piper (self-hosted, free)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
TTS_PRIMARY_PROVIDER=elevenlabs      # elevenlabs | piper
PIPER_BINARY=piper                   # path to the piper executable
PIPER_MODEL_PATH=./models/en_US-lessac-medium.onnx

# -----------------------------------------------------------------------------
# Database — PostgreSQL (Neon / Supabase). SQLite is used by default for local dev
# and tests so nothing external is required to run the suite.
# Postgres example:
#   postgresql+asyncpg://user:pass@ep-xxx.neon.tech/vox?ssl=require
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./vox_orchestrator.sqlite3
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# -----------------------------------------------------------------------------
# Cache / session state — Redis (Upstash). Leave empty to use the built-in
# in-process fallback store (fine for a single worker).
# Example: rediss://default:password@apn1-xxx.upstash.io:6379
# -----------------------------------------------------------------------------
REDIS_URL=
SESSION_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Conversation policy / guardrails
# -----------------------------------------------------------------------------
AGENT_NAME=Riya
AGENCY_NAME=Northstar Digital
AGENT_CALLBACK_NUMBER=+911140000000
MAX_OBJECTION_CYCLES=3               # >3 -> force transition to Close/EndCall
MAX_CONVERSATION_TURNS=40            # hard stop, prevents infinite loops
SILENCE_TIMEOUT_SECONDS=7            # no speech -> "are you still there?" (once) -> hang up
MAX_ASR_REPEAT_REQUESTS=1
MAX_TOOL_VALIDATION_RETRIES=1        # then fall back to a scripted safe line

# -----------------------------------------------------------------------------
# Retry / backoff for unanswered calls (minutes, comma separated)
# -----------------------------------------------------------------------------
CALL_RETRY_BACKOFF_MINUTES=60,240,1440
CALL_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Research tool
# -----------------------------------------------------------------------------
RESEARCH_ENABLED=true
RESEARCH_TIMEOUT_SECONDS=8
RESEARCH_CACHE_DAYS=30
RESEARCH_USER_AGENT=vox-orchestrator/1.0 (+https://github.com/Krypto-etox/vox-orchestrator)

# -----------------------------------------------------------------------------
# Observability — Arize Phoenix / OpenTelemetry (optional)
# -----------------------------------------------------------------------------
TRACING_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=vox-orchestrator

# -----------------------------------------------------------------------------
# Compliance (India) — see Project-Details.md §10
# -----------------------------------------------------------------------------
COMPLIANCE_DNC_CHECK_ENABLED=true    # block dialing numbers flagged do_not_call
COMPLIANCE_DLT_REGISTERED=false      # must be true before dialing real leads in production
CALLING_WINDOW_START_HOUR=9          # local (IST) hour, inclusive
CALLING_WINDOW_END_HOUR=19           # local (IST) hour, exclusive
CALLING_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# Eval harness
# -----------------------------------------------------------------------------
EVAL_LLM_PROVIDER=mock               # mock (offline, deterministic) | groq | gemini
EVAL_MAX_TURNS=25
EVAL_REPORT_DIR=eval/reports
